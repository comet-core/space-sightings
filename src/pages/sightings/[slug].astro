---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import {
  formatDistanceAU,
  formatCompactDistance,
  formatDistanceKM,
  formatLightTravelTime,
  formatMagnitude,
  getBortleDescription,
  resolveImagePath,
  CATEGORY_META,
} from '../../utils/telemetry';
import {
  ChevronLeft,
  ChevronRight,
  Crosshair,
  Camera,
  Compass,
  Orbit,
  Clock,
  Layers,
  ShieldCheck,
  Zap,
  MapPin,
  ExternalLink,
} from 'lucide-astro';

export async function getStaticPaths() {
  const sightings = await getCollection('sightings');

  // Sort by distance scale ladder for next/prev links
  const sorted = [...sightings].sort(
    (a, b) => a.data.ephemeris.distanceAU - b.data.ephemeris.distanceAU
  );

  return sorted.map((sighting, index) => {
    const prev = index > 0 ? sorted[index - 1] : null;
    const next = index < sorted.length - 1 ? sorted[index + 1] : null;

    return {
      params: { slug: sighting.id },
      props: { sighting, prev, next },
    };
  });
}

const { sighting, prev, next } = Astro.props;
const { data, id } = sighting;
const { Content } = await render(sighting);

const cat = CATEGORY_META[data.category] || CATEGORY_META['solar-system'];
const bortleInfo = getBortleDescription(data.location.bortleClass);
const kmDistance = Math.round(data.ephemeris.distanceAU * 149597870.7);
const dateIso = new Date(data.timestamp).toISOString().replace('T', ' ').substring(0, 19) + ' UTC';

const resolvedRawImage = resolveImagePath(data.rawImage);
const resolvedStellariumImage = resolveImagePath(data.stellariumImage);
---

<Layout
  title={`${data.target} Telemetry Dossier // ${data.title}`}
  description={`Telemetry data and high-resolution astrophotography analysis for ${data.target}. Captured at ${data.location.name}.`}
>
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
    <!-- Breadcrumbs & Quick Back Link -->
    <nav class="flex items-center justify-between text-xs font-mono text-zinc-500 border-b border-zinc-800/80 pb-4">
      <div class="flex items-center gap-2">
        <a href="/" class="text-zinc-400 hover:text-cyan-400 transition-colors flex items-center gap-1">
          <ChevronLeft class="w-3.5 h-3.5" />
          <span>ARCHIVE INDEX</span>
        </a>
        <span>/</span>
        <span class={`uppercase font-medium ${cat.color}`}>{cat.label}</span>
        <span>/</span>
        <span class="text-zinc-200 font-bold">{data.target}</span>
      </div>

      <div class="hidden sm:flex items-center gap-2 text-[11px]">
        <span class="text-zinc-600">ID:</span>
        <span class="text-cyan-400 font-mono">{id}</span>
      </div>
    </nav>

    <!-- Top Target Header Dossier -->
    <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
      <div class="space-y-2">
        <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
          <span class={`px-2.5 py-0.5 rounded border ${cat.bg} ${cat.border} ${cat.color} font-medium flex items-center gap-1.5`}>
            <span>{cat.icon}</span>
            <span class="uppercase tracking-wider">{cat.label} SECTOR</span>
          </span>
          <span class="text-zinc-600">·</span>
          <span class="text-zinc-400 font-mono">{dateIso}</span>
          <span class="text-zinc-600">·</span>
          <span class="text-zinc-400 font-mono flex items-center gap-1">
            <MapPin class="w-3 h-3 text-cyan-400" />
            <span>{data.location.name}</span>
          </span>
        </div>

        <h1 class="text-3xl sm:text-5xl font-extrabold font-mono text-zinc-100 tracking-tight flex flex-wrap items-center gap-3">
          <span>{data.target}</span>
          {data.ephemeris.phasePercent !== undefined && (
            <span class="text-sm font-normal text-zinc-400 bg-zinc-800/80 px-2.5 py-1 rounded-md border border-zinc-700">
              {data.ephemeris.phasePercent}% Phase
            </span>
          )}
        </h1>

        <p class="text-base text-zinc-400 font-sans max-w-3xl">
          {data.title}
        </p>
      </div>

      <!-- Quick Metrics Pill Strip -->
      <div class="flex flex-wrap items-center gap-3 font-mono">
        <div class="px-4 py-2.5 rounded-xl bg-zinc-950/80 border border-zinc-800 text-right">
          <div class="text-[10px] text-zinc-500 uppercase">APP MAGNITUDE</div>
          <div class="text-lg font-bold text-emerald-400">{formatMagnitude(data.ephemeris.apparentMagnitude)}</div>
        </div>

        <div class="px-4 py-2.5 rounded-xl bg-zinc-950/80 border border-zinc-800 text-right">
          <div class="text-[10px] text-zinc-500 uppercase">SOLAR DISTANCE</div>
          <div class="text-lg font-bold text-cyan-400">{formatDistanceAU(data.ephemeris.distanceAU)}</div>
        </div>
      </div>
    </div>

    <!-- Dual Optical Feed Viewer: Raw Sensor vs. Stellarium Alignment vs. Dual Blend -->
    <div class="rounded-2xl border border-zinc-800 bg-black overflow-hidden shadow-2xl flex flex-col">
      <!-- Viewer Header Toolbar -->
      <div class="px-4 sm:px-5 py-2.5 sm:py-3 bg-zinc-900/90 border-b border-zinc-800 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 text-xs font-mono">
        <div class="flex items-center justify-between sm:justify-start gap-2.5">
          <span class="text-zinc-400 uppercase text-[10px] sm:text-[11px] font-semibold flex items-center gap-1.5 shrink-0">
            <Crosshair class="w-3.5 h-3.5 text-cyan-400" />
            <span class="hidden sm:inline">OPTICAL </span>FEED:
          </span>

          <div class="inline-flex rounded-lg p-0.5 bg-zinc-950 border border-zinc-800 flex-1 sm:flex-initial" role="tablist">
            <button
              type="button"
              id="page-tab-raw"
              class="flex-1 sm:flex-initial px-2.5 sm:px-3 py-1.5 rounded-md text-cyan-400 font-medium bg-zinc-800 shadow-sm transition-all text-center text-xs min-h-[34px]"
            >
              <span class="hidden sm:inline">1. SENSOR </span>RAW
            </button>
            {resolvedStellariumImage && (
              <button
                type="button"
                id="page-tab-stellarium"
                class="flex-1 sm:flex-initial px-2.5 sm:px-3 py-1.5 rounded-md text-zinc-400 hover:text-zinc-200 transition-all text-center text-xs min-h-[34px]"
              >
                <span class="hidden sm:inline">2. STELLARIUM </span>RETICLE
              </button>
            )}
            {resolvedStellariumImage && (
              <button
                type="button"
                id="page-tab-blend"
                class="flex-1 sm:flex-initial px-2.5 sm:px-3 py-1.5 rounded-md text-zinc-400 hover:text-zinc-200 transition-all flex items-center justify-center gap-1.5 text-xs min-h-[34px]"
              >
                <Layers class="w-3.5 h-3.5 text-amber-400 shrink-0" />
                <span><span class="hidden sm:inline">3. DUAL </span>BLEND</span>
              </button>
            )}
          </div>
        </div>

        <!-- Opacity Crossfade Slider for Dual Blend Mode -->
        {resolvedStellariumImage && (
          <div id="page-blend-controls" class="hidden items-center justify-between sm:justify-start gap-2 bg-zinc-950 px-3 py-1.5 rounded-lg border border-zinc-800 w-full sm:w-auto">
            <span class="text-[10px] sm:text-[11px] text-zinc-400 shrink-0">RAW SENSOR</span>
            <input
              type="range"
              id="page-opacity-slider"
              min="0"
              max="100"
              value="50"
              class="flex-1 sm:w-40 accent-cyan-400 cursor-pointer h-2 bg-zinc-700 rounded-lg touch-none"
              aria-label="Stellarium Reticle Opacity Blend"
            />
            <span class="text-[10px] sm:text-[11px] text-red-400 font-bold shrink-0">RETICLE</span>
            <span id="page-slider-pct" class="text-[10px] sm:text-[11px] text-zinc-300 w-8 text-right font-bold shrink-0">50%</span>
          </div>
        )}
      </div>

      <!-- Main High-Res Image Display Canvas -->
      <div class="relative w-full aspect-[16/10] max-h-[640px] bg-black flex items-center justify-center overflow-hidden">
        <!-- Sensor Raw Capture -->
        <img
          id="page-raw-img"
          src={resolvedRawImage}
          alt={`Raw Sensor Capture of ${data.target}`}
          class={`absolute inset-0 w-full h-full ${data.imagePosition ? 'object-cover' : 'object-contain'} transition-opacity duration-300`}
          style={data.imagePosition ? `object-position: ${data.imagePosition};` : undefined}
        />

        <!-- Stellarium Alignment Reticle -->
        {resolvedStellariumImage && (
          <img
            id="page-stellarium-img"
            src={resolvedStellariumImage}
            alt={`Stellarium reticle overlay for ${data.target}`}
            class="absolute inset-0 w-full h-full object-contain opacity-0 transition-opacity duration-300 pointer-events-none"
          />
        )}

        <!-- Status Tag Watermark -->
        <div class="absolute bottom-4 left-4 px-3 py-1.5 rounded-lg bg-black/85 border border-zinc-800 text-xs font-mono text-zinc-300 flex items-center gap-2 backdrop-blur-md pointer-events-none">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          <span id="page-canvas-status">MODE: SENSOR RAW CAPTURE</span>
        </div>
      </div>
    </div>

    <!-- Telemetry HUD & Specifications Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 font-mono text-xs">
      <!-- Card 1: Orbital Kinematics -->
      <div class="p-5 rounded-2xl bg-zinc-950/70 border border-zinc-800/90 space-y-4">
        <div class="flex items-center justify-between border-b border-zinc-800 pb-3">
          <div class="text-cyan-400 font-bold uppercase tracking-wider flex items-center gap-2">
            <Orbit class="w-4 h-4" />
            <span>ORBITAL KINEMATICS</span>
          </div>
          <span class="text-[10px] text-zinc-500">JPL HORIZONS REF</span>
        </div>

        <div class="space-y-2.5 text-zinc-300">
          <div class="flex justify-between items-baseline py-1 border-b border-zinc-900">
            <span class="text-zinc-500">{data.ephemeris.distanceAU >= 1000 ? 'Distance (LY):' : 'Distance (AU):'}</span>
            <span class="font-bold text-zinc-100">{formatDistanceAU(data.ephemeris.distanceAU)}</span>
          </div>
          <div class="flex justify-between items-baseline py-1 border-b border-zinc-900">
            <span class="text-zinc-500">{data.ephemeris.distanceAU >= 1000 ? 'Distance (AU):' : 'Distance (LY):'}</span>
            <span class="text-zinc-300">{data.ephemeris.distanceAU >= 1000 ? `${data.ephemeris.distanceAU.toLocaleString('en-US')} AU` : `${(data.ephemeris.distanceAU / 63241.077).toFixed(5)} ly`}</span>
          </div>
          <div class="flex justify-between items-baseline py-1 border-b border-zinc-900">
            <span class="text-zinc-500">Distance (KM):</span>
            <span class="text-zinc-300">{formatDistanceKM(data.ephemeris.distanceAU)}</span>
          </div>
          <div class="flex justify-between items-baseline py-1 border-b border-zinc-900">
            <span class="text-zinc-500">Light Delay:</span>
            <span class="text-amber-400 font-bold">{formatLightTravelTime(data.ephemeris.lightTravelTimeMinutes)}</span>
          </div>
          <div class="flex justify-between items-baseline py-1 border-b border-zinc-900">
            <span class="text-zinc-500">Constellation:</span>
            <span class="text-cyan-300 font-semibold">{data.ephemeris.constellation}</span>
          </div>
          <div class="flex justify-between items-baseline py-1">
            <span class="text-zinc-500">Apparent Magnitude:</span>
            <span class="text-emerald-400 font-bold">{formatMagnitude(data.ephemeris.apparentMagnitude)}</span>
          </div>
        </div>
      </div>

      <!-- Card 2: Sensor Optics & Processing -->
      <div class="p-5 rounded-2xl bg-zinc-950/70 border border-zinc-800/90 space-y-4">
        <div class="flex items-center justify-between border-b border-zinc-800 pb-3">
          <div class="text-cyan-400 font-bold uppercase tracking-wider flex items-center gap-2">
            <Camera class="w-4 h-4" />
            <span>OPTICAL HARDWARE</span>
          </div>
          <span class="text-[10px] text-zinc-500">RAW EXIF</span>
        </div>

        <div class="space-y-2.5 text-zinc-300">
          <div class="flex justify-between items-baseline py-1 border-b border-zinc-900">
            <span class="text-zinc-500">Capture Device:</span>
            <span class="font-bold text-zinc-100 text-right max-w-[180px] truncate" title={data.optics.device}>
              {data.optics.device}
            </span>
          </div>
          <div class="flex justify-between items-baseline py-1 border-b border-zinc-900">
            <span class="text-zinc-500">Focal Length:</span>
            <span class="text-zinc-300">{data.optics.focalLength}</span>
          </div>
          <div class="flex justify-between items-baseline py-1 border-b border-zinc-900">
            <span class="text-zinc-500">Shutter Speed:</span>
            <span class="text-zinc-100 font-bold">{data.optics.exposure}</span>
          </div>
          <div class="flex justify-between items-baseline py-1 border-b border-zinc-900">
            <span class="text-zinc-500">Sensor ISO:</span>
            <span class="text-zinc-100 font-bold">ISO {data.optics.iso}</span>
          </div>
          <div class="flex justify-between items-baseline py-1">
            <span class="text-zinc-500">Stacking Pipeline:</span>
            <span class={data.optics.stacked ? 'text-emerald-400 font-semibold' : 'text-zinc-400'}>
              {data.optics.stacked ? 'Multi-Frame Burst Alignment' : 'Single Raw Exposure'}
            </span>
          </div>
        </div>
      </div>

      <!-- Card 3: Observation Site & Sky Conditions -->
      <div class="p-5 rounded-2xl bg-zinc-950/70 border border-zinc-800/90 space-y-4">
        <div class="flex items-center justify-between border-b border-zinc-800 pb-3">
          <div class="text-cyan-400 font-bold uppercase tracking-wider flex items-center gap-2">
            <Compass class="w-4 h-4" />
            <span>SKY CONDITIONS</span>
          </div>
          <span class="text-[10px] text-zinc-500">ATMOSPHERIC</span>
        </div>

        <div class="space-y-2.5 text-zinc-300">
          <div class="flex justify-between items-baseline py-1 border-b border-zinc-900">
            <span class="text-zinc-500">Site Location:</span>
            <span class="font-bold text-zinc-100 text-right max-w-[180px] truncate" title={data.location.name}>
              {data.location.name}
            </span>
          </div>
          <div class="flex justify-between items-baseline py-1 border-b border-zinc-900">
            <span class="text-zinc-500">Bortle Darkness:</span>
            <span class={`font-bold ${bortleInfo.color}`}>
              {bortleInfo.label}
            </span>
          </div>
          <div class="flex justify-between items-baseline py-1 border-b border-zinc-900">
            <span class="text-zinc-500">Illumination Phase:</span>
            <span class="text-zinc-300">
              {data.ephemeris.phasePercent !== undefined ? `${data.ephemeris.phasePercent}%` : 'N/A'}
            </span>
          </div>
          <div class="flex justify-between items-baseline py-1">
            <span class="text-zinc-500">Plate Solve Verification:</span>
            <span class="text-emerald-400 font-semibold flex items-center gap-1">
              <ShieldCheck class="w-3.5 h-3.5" />
              <span>Confirmed Match</span>
            </span>
          </div>
        </div>
      </div>
    </div>

    <!-- Observation Field Notes & Markdown Article Body -->
    <div class="rounded-2xl border border-zinc-800 bg-zinc-950/80 p-6 sm:p-8 space-y-6">
      <div class="border-b border-zinc-800 pb-4 flex items-center justify-between">
        <h2 class="text-lg font-bold font-mono text-zinc-100 flex items-center gap-2">
          <span class="text-cyan-400 font-bold">#</span>
          <span>OBSERVATIONAL LOG &amp; FIELD NOTES</span>
        </h2>
        <span class="text-xs font-mono text-zinc-500 uppercase">FIELD REPORT</span>
      </div>

      <!-- Quick Executive Summary Note -->
      <div class="p-4 rounded-xl bg-zinc-900/70 border border-zinc-800 text-sm font-mono text-zinc-200 leading-relaxed">
        <span class="text-cyan-400 font-bold mr-2">&gt;&gt;</span>
        {data.notes}
      </div>

      <!-- Rendered Markdown Content -->
      <div class="prose prose-invert prose-zinc max-w-none font-sans text-sm sm:text-base leading-relaxed text-zinc-300">
        <Content />
      </div>
    </div>

    <!-- Adjacent Cosmic Ladder Navigation -->
    <div class="pt-6 border-t border-zinc-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-xs">
      {prev ? (
        <a
          href={`/sightings/${prev.id}`}
          class="w-full sm:w-auto p-4 rounded-xl border border-zinc-800 bg-zinc-900/60 hover:bg-zinc-800/80 hover:border-cyan-500/50 transition-all flex items-center gap-3"
        >
          <ChevronLeft class="w-4 h-4 text-cyan-400" />
          <div class="text-left">
            <div class="text-[10px] text-zinc-500">CLOSER RUNG (LADDER)</div>
            <div class="font-bold text-zinc-100">{prev.data.target}</div>
            <div class="text-[10px] text-cyan-400">{formatCompactDistance(prev.data.ephemeris.distanceAU)}</div>
          </div>
        </a>
      ) : (
        <div class="w-full sm:w-auto p-4 rounded-xl border border-zinc-900 bg-zinc-950/40 text-zinc-600">
          EARTH CLOSEST RUNG
        </div>
      )}

      <a
        href="/"
        class="px-5 py-2.5 rounded-xl border border-zinc-700 bg-zinc-800 hover:bg-zinc-700 text-zinc-200 transition-colors"
      >
        RETURN TO ARCHIVE INDEX
      </a>

      {next ? (
        <a
          href={`/sightings/${next.id}`}
          class="w-full sm:w-auto p-4 rounded-xl border border-zinc-800 bg-zinc-900/60 hover:bg-zinc-800/80 hover:border-cyan-500/50 transition-all flex items-center justify-end gap-3 text-right"
        >
          <div>
            <div class="text-[10px] text-zinc-500">FURTHER RUNG (LADDER)</div>
            <div class="font-bold text-zinc-100">{next.data.target}</div>
            <div class="text-[10px] text-cyan-400">{formatCompactDistance(next.data.ephemeris.distanceAU)}</div>
          </div>
          <ChevronRight class="w-4 h-4 text-cyan-400" />
        </a>
      ) : (
        <div class="w-full sm:w-auto p-4 rounded-xl border border-zinc-900 bg-zinc-950/40 text-zinc-600 text-right">
          MAX ARCHIVE BOUNDARY
        </div>
      )}
    </div>
  </main>
</Layout>

<script>
  // Page dual-view viewer switcher logic
  const tabRaw = document.getElementById('page-tab-raw');
  const tabStellarium = document.getElementById('page-tab-stellarium');
  const tabBlend = document.getElementById('page-tab-blend');
  const blendControls = document.getElementById('page-blend-controls');
  const slider = document.getElementById('page-opacity-slider') as HTMLInputElement | null;
  const sliderPct = document.getElementById('page-slider-pct');

  const rawImg = document.getElementById('page-raw-img');
  const stellariumImg = document.getElementById('page-stellarium-img');
  const statusLabel = document.getElementById('page-canvas-status');

  function setPageMode(mode: 'raw' | 'stellarium' | 'blend') {
    if (!rawImg) return;

    [tabRaw, tabStellarium, tabBlend].forEach((tab) => {
      tab?.classList.remove('bg-zinc-800', 'text-cyan-400', 'text-white', 'shadow-sm');
      tab?.classList.add('text-zinc-400');
    });

    if (mode === 'raw') {
      tabRaw?.classList.add('bg-zinc-800', 'text-cyan-400', 'shadow-sm');
      rawImg.style.opacity = '1';
      if (stellariumImg) stellariumImg.style.opacity = '0';
      blendControls?.classList.add('hidden');
      blendControls?.classList.remove('flex');
      if (statusLabel) statusLabel.textContent = 'MODE: SENSOR RAW CAPTURE';
    } else if (mode === 'stellarium' && stellariumImg) {
      tabStellarium?.classList.add('bg-zinc-800', 'text-cyan-400', 'shadow-sm');
      rawImg.style.opacity = '0';
      stellariumImg.style.opacity = '1';
      blendControls?.classList.add('hidden');
      blendControls?.classList.remove('flex');
      if (statusLabel) statusLabel.textContent = 'MODE: STELLARIUM RETICLE SKY MAP';
    } else if (mode === 'blend' && stellariumImg) {
      tabBlend?.classList.add('bg-zinc-800', 'text-white', 'shadow-sm');
      rawImg.style.opacity = '1';
      const pct = slider ? Number(slider.value) / 100 : 0.5;
      stellariumImg.style.opacity = String(pct);
      blendControls?.classList.remove('hidden');
      blendControls?.classList.add('flex');
      if (statusLabel) statusLabel.textContent = `MODE: DUAL BLEND OVERLAY (${Math.round(pct * 100)}% RETICLE)`;
    }
  }

  tabRaw?.addEventListener('click', () => setPageMode('raw'));
  tabStellarium?.addEventListener('click', () => setPageMode('stellarium'));
  tabBlend?.addEventListener('click', () => setPageMode('blend'));

  slider?.addEventListener('input', () => {
    if (stellariumImg && slider) {
      const pct = Number(slider.value);
      stellariumImg.style.opacity = String(pct / 100);
      if (sliderPct) sliderPct.textContent = `${pct}%`;
      if (statusLabel) statusLabel.textContent = `MODE: DUAL BLEND OVERLAY (${pct}% RETICLE)`;
    }
  });
</script>

