---
import type { CollectionEntry } from 'astro:content';
import { Crosshair, Eye, Compass, Clock, Zap, Maximize2 } from 'lucide-astro';
import { formatDistanceAU, formatCompactDistance, formatLightTravelTime, resolveImagePath, CATEGORY_META } from '../utils/telemetry';

interface Props {
  sighting: CollectionEntry<'sightings'>;
}

const { sighting } = Astro.props;
const { data, id } = sighting;
const cat = CATEGORY_META[data.category] || CATEGORY_META['solar-system'];
const dateFormatted = new Date(data.timestamp).toISOString().replace('T', ' ').substring(0, 16) + ' UTC';

const resolvedRawImage = resolveImagePath(data.rawImage);
const resolvedStellariumImage = resolveImagePath(data.stellariumImage);

// Format apparent magnitude string
const magString = data.ephemeris.apparentMagnitude > 0
  ? `+${data.ephemeris.apparentMagnitude.toFixed(2)}`
  : data.ephemeris.apparentMagnitude.toFixed(2);
---

<article
  class="sighting-card group relative flex flex-col rounded-xl border border-zinc-800/80 bg-zinc-900/60 hover:bg-zinc-900/90 transition-all duration-300 hover:border-cyan-500/50 hover:shadow-glow-cyan overflow-hidden"
  data-category={data.category}
  data-distance={data.ephemeris.distanceAU}
  data-timestamp={new Date(data.timestamp).getTime()}
  data-magnitude={data.ephemeris.apparentMagnitude}
  data-target={data.target.toLowerCase()}
  data-constellation={data.ephemeris.constellation.toLowerCase()}
  data-id={id}
>
  <!-- Card Header Bar -->
  <div class="px-4 py-3 border-b border-zinc-800/80 flex items-center justify-between font-mono text-xs bg-zinc-950/50">
    <div class="flex items-center gap-2">
      <span class={`inline-flex items-center gap-1 px-2 py-0.5 rounded border text-[11px] font-medium ${cat.bg} ${cat.border} ${cat.color}`}>
        <span>{cat.icon}</span>
        <span class="tracking-wide uppercase">{cat.label}</span>
      </span>
      <span class="text-zinc-600 hidden sm:inline">|</span>
      <span class="text-zinc-400 font-medium tracking-tight text-[11px] truncate max-w-[130px]" title={data.ephemeris.constellation}>
        {data.ephemeris.constellation}
      </span>
    </div>

    <!-- Distance Badge (Shows LY for stellar objects and AU for solar system) -->
    <div
      class="flex items-center gap-1.5 px-2 py-0.5 rounded bg-zinc-800/80 border border-zinc-700/60 text-cyan-300 font-semibold text-[11px]"
      title={formatDistanceAU(data.ephemeris.distanceAU)}
    >
      <span class="text-zinc-400 font-normal">DIST:</span>
      <span>{formatCompactDistance(data.ephemeris.distanceAU)}</span>
    </div>
  </div>

  <!-- Image Visual Container with Hover Zoom & Quick Stellarium Reticle Toggle -->
  <div class="relative w-full aspect-[16/10] bg-black overflow-hidden group/img">
    <!-- Raw Astrophotography Image (Default) -->
    <img
      src={resolvedRawImage}
      alt={`Sensor capture of ${data.target}`}
      loading="lazy"
      class="card-raw-image w-full h-full object-cover transition-transform duration-500 group-hover/img:scale-105"
      style={data.imagePosition ? `object-position: ${data.imagePosition};` : undefined}
    />

    <!-- Stellarium Reticle Image (Toggleable Overlay) -->
    {resolvedStellariumImage && (
      <img
        src={resolvedStellariumImage}
        alt={`Stellarium reticle overlay for ${data.target}`}
        loading="lazy"
        class="card-reticle-image absolute inset-0 w-full h-full object-cover opacity-0 pointer-events-none transition-opacity duration-300"
      />
    )}

    <!-- Corner Sci-Fi Telemetry Accents -->
    <div class="absolute top-2 left-2 pointer-events-none">
      <div class="w-3 h-3 border-t-2 border-l-2 border-cyan-400/60"></div>
    </div>
    <div class="absolute top-2 right-2 pointer-events-none">
      <div class="w-3 h-3 border-t-2 border-r-2 border-cyan-400/60"></div>
    </div>
    <div class="absolute bottom-2 left-2 pointer-events-none">
      <div class="w-3 h-3 border-b-2 border-l-2 border-cyan-400/60"></div>
    </div>
    <div class="absolute bottom-2 right-2 pointer-events-none">
      <div class="w-3 h-3 border-b-2 border-r-2 border-cyan-400/60"></div>
    </div>

    <!-- Quick Reticle Preview Switch Button (if Stellarium overlay exists) -->
    {data.stellariumImage && (
      <button
        type="button"
        class="toggle-reticle-btn absolute bottom-3 right-3 z-10 px-2 py-1 rounded bg-zinc-950/85 hover:bg-red-950/90 text-zinc-300 hover:text-red-400 border border-zinc-700 hover:border-red-500/80 text-[10px] font-mono flex items-center gap-1.5 backdrop-blur-sm transition-all shadow-md active:scale-95"
        title="Toggle Stellarium Sky Map Reticle"
        aria-label={`Toggle Stellarium overlay for ${data.target}`}
      >
        <Crosshair class="w-3 h-3 text-red-400 animate-spin-slow" />
        <span class="btn-label">RETICLE</span>
      </button>
    )}

    <!-- Sensor HUD Overlay Tag -->
    <div class="absolute top-3 left-3 px-2 py-0.5 rounded bg-black/75 border border-zinc-700/60 text-zinc-400 text-[10px] font-mono tracking-wide backdrop-blur-sm pointer-events-none flex items-center gap-1">
      <span class="w-1.5 h-1.5 rounded-full bg-cyan-400"></span>
      <span class="hidden sm:inline">SENSOR:</span>
      <span class="text-zinc-200">{data.optics.stacked ? 'STACKED HDR' : 'SINGLE SHOT'}</span>
    </div>
  </div>

  <!-- Primary Target Card Body -->
  <div class="p-4 flex-1 flex flex-col justify-between">
    <div>
      <div class="flex items-start justify-between gap-2">
        <div>
          <h3 class="text-lg font-bold text-zinc-100 group-hover:text-cyan-300 transition-colors font-mono tracking-tight flex items-center gap-2">
            <span>{data.target}</span>
            {data.ephemeris.phasePercent !== undefined && (
              <span class="text-[11px] font-normal text-zinc-400 bg-zinc-800/80 px-1.5 py-0.5 rounded border border-zinc-700/50">
                {data.ephemeris.phasePercent}% Illum
              </span>
            )}
          </h3>
          <p class="text-xs text-zinc-400 font-sans mt-0.5 line-clamp-1">{data.title}</p>
        </div>

        <!-- High-Contrast Apparent Magnitude -->
        <div class="text-right">
          <div class="text-[10px] font-mono text-zinc-500 uppercase tracking-wider">MAG</div>
          <div class="font-mono text-sm font-bold text-emerald-400 tracking-tight">
            {magString}
          </div>
        </div>
      </div>

      <!-- Quick Telemetry HUD Data Grid -->
      <div class="mt-3.5 grid grid-cols-2 gap-2 text-[11px] font-mono bg-zinc-950/60 p-2.5 rounded-lg border border-zinc-800/60">
        <div class="flex items-center gap-1.5 text-zinc-400">
          <Clock class="w-3.5 h-3.5 text-zinc-500 shrink-0" />
          <span class="truncate" title={dateFormatted}>{dateFormatted.split(' ')[0]}</span>
        </div>
        <div class="flex items-center gap-1.5 text-zinc-400 justify-end">
          <Zap class="w-3.5 h-3.5 text-amber-500/80 shrink-0" />
          <span class="text-amber-300/90">{formatLightTravelTime(data.ephemeris.lightTravelTimeMinutes)} delay</span>
        </div>
        <div class="flex items-center gap-1.5 text-zinc-400 truncate">
          <Compass class="w-3.5 h-3.5 text-cyan-500/80 shrink-0" />
          <span class="truncate">{data.optics.exposure} · ISO {data.optics.iso}</span>
        </div>
        <div class="flex items-center gap-1.5 text-zinc-400 justify-end">
          <span class="text-[10px] px-1 rounded bg-zinc-800 text-zinc-300">Bortle {data.location.bortleClass}</span>
        </div>
      </div>
    </div>

    <!-- Action Bar: Inspect Modal vs Full Dossier -->
    <div class="mt-4 pt-3 border-t border-zinc-800/60 flex items-center justify-between gap-2">
      <!-- Open Interactive Modal Button -->
      <button
        type="button"
        class="open-modal-btn px-3.5 py-2 min-h-[38px] rounded-lg bg-cyan-950/40 hover:bg-cyan-900/60 text-cyan-300 border border-cyan-800/60 hover:border-cyan-400 text-xs font-mono font-medium flex items-center gap-1.5 transition-all shadow-sm active:scale-95"
        data-sighting={JSON.stringify({
          id,
          title: data.title,
          target: data.target,
          category: data.category,
          timestamp: data.timestamp,
          location: data.location,
          ephemeris: data.ephemeris,
          optics: data.optics,
          notes: data.notes,
          rawImage: resolvedRawImage,
          stellariumImage: resolvedStellariumImage,
          imagePosition: data.imagePosition,
        })}
      >
        <Maximize2 class="w-3.5 h-3.5" />
        <span>Inspect Telemetry</span>
      </button>

      <!-- Permanent SSG Page Link -->
      <a
        href={`/sightings/${id}`}
        class="px-2.5 py-1.5 rounded-md text-zinc-400 hover:text-zinc-100 hover:bg-zinc-800/60 text-xs font-mono flex items-center gap-1 transition-colors"
        title={`View dedicated page for ${data.target}`}
      >
        <span>Dossier</span>
        <span class="text-cyan-400">»</span>
      </a>
    </div>
  </div>
</article>

<script>
  // Add quick toggle functionality for card reticle previews
  document.querySelectorAll('.sighting-card').forEach((card) => {
    const toggleBtn = card.querySelector('.toggle-reticle-btn');
    const reticleImg = card.querySelector('.card-reticle-image');
    const btnLabel = card.querySelector('.btn-label');

    if (toggleBtn && reticleImg && btnLabel) {
      let isReticleActive = false;
      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        e.preventDefault();
        isReticleActive = !isReticleActive;

        if (isReticleActive) {
          reticleImg.classList.remove('opacity-0', 'pointer-events-none');
          reticleImg.classList.add('opacity-100');
          toggleBtn.classList.add('bg-red-900/80', 'border-red-400', 'text-white');
          btnLabel.textContent = 'RAW VIEW';
        } else {
          reticleImg.classList.remove('opacity-100');
          reticleImg.classList.add('opacity-0', 'pointer-events-none');
          toggleBtn.classList.remove('bg-red-900/80', 'border-red-400', 'text-white');
          btnLabel.textContent = 'RETICLE';
        }
      });
    }
  });
</script>

