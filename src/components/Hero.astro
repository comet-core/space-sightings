---
import { Telescope, Radio, Orbit, Activity, ShieldCheck, Compass } from 'lucide-astro';
import type { CollectionEntry } from 'astro:content';
import { formatDistanceAU, formatCompactDistance, formatLightTravelTime } from '../utils/telemetry';

interface Props {
  sightings: CollectionEntry<'sightings'>[];
}

const { sightings } = Astro.props;

// Compute live observation statistics
const totalCaptures = sightings.length;

// Find furthest object in AU
const sortedByDistance = [...sightings].sort(
  (a, b) => b.data.ephemeris.distanceAU - a.data.ephemeris.distanceAU
);
const furthestObject = sortedByDistance[0] || {
  data: {
    target: 'Altair (α Aquilae)',
    ephemeris: { distanceAU: 1058000 },
  },
};

// Find latest target by timestamp
const sortedByDate = [...sightings].sort(
  (a, b) => new Date(b.data.timestamp).getTime() - new Date(a.data.timestamp).getTime()
);
const latestTarget = sortedByDate[0] || {
  data: {
    target: 'Altair (α Aquilae)',
    timestamp: new Date().toISOString(),
  },
};

// Scale Ladder nodes (ascending from Earth)
const scaleLadderItems = [...sightings].sort(
  (a, b) => a.data.ephemeris.distanceAU - b.data.ephemeris.distanceAU
);
---

<section class="relative py-12 md:py-16 border-b border-zinc-800/80 overflow-hidden">
  <!-- Glowing Ambient Accents -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-cyan-500/5 blur-[120px] rounded-full pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-8">
      <!-- Title & Mission Dossier -->
      <div class="max-w-2xl space-y-4">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-cyan-500/30 bg-cyan-950/40 text-cyan-300 text-xs font-mono font-medium tracking-wide">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
          <span>OPTICAL RECONNAISSANCE &amp; EPHEMERIS DATABASE</span>
        </div>

        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight font-mono text-zinc-100 uppercase">
          CELESTIAL <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-teal-300 to-emerald-400">TELEMETRY</span> ARCHIVE
        </h1>

        <p class="text-sm sm:text-base text-zinc-400 font-sans leading-relaxed">
          Wide-field mobile sensor captures calibrated against Stellarium coordinate ephemeris. Tracking photon baselines from 1.28-second lunar bounces out to 16.7-year-old stellar emissions.
        </p>

        <!-- Secondary status tags grounded in reality -->
        <div class="flex flex-wrap items-center gap-3 pt-2 text-xs font-mono text-zinc-400">
          <span class="flex items-center gap-1.5 px-2.5 py-1 rounded bg-zinc-900 border border-zinc-800">
            <ShieldCheck class="w-3.5 h-3.5 text-emerald-400" />
            <span>EPHEMERIS MATCHED: 100%</span>
          </span>
          <span class="flex items-center gap-1.5 px-2.5 py-1 rounded bg-zinc-900 border border-zinc-800">
            <Radio class="w-3.5 h-3.5 text-cyan-400" />
            <span>BROADBAND RGB • RAW SENSOR</span>
          </span>
          <span class="flex items-center gap-1.5 px-2.5 py-1 rounded bg-zinc-900 border border-zinc-800">
            <Compass class="w-3.5 h-3.5 text-amber-400" />
            <span>EPOCH J2000.0</span>
          </span>
        </div>
      </div>

      <!-- Live Observation Stats Counter Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 lg:grid-cols-1 gap-3.5 lg:w-80 shrink-0">
        <!-- Stat 1: Total Captures -->
        <div class="p-4 rounded-xl border border-zinc-800 bg-zinc-950/70 backdrop-blur-md hover:border-cyan-500/40 transition-colors">
          <div class="flex items-center justify-between text-xs font-mono text-zinc-500">
            <span class="uppercase tracking-wider">TOTAL CAPTURES</span>
            <Telescope class="w-4 h-4 text-cyan-400" />
          </div>
          <div class="mt-2 text-3xl font-extrabold font-mono text-zinc-100 flex items-baseline gap-2">
            <span>{totalCaptures}</span>
            <span class="text-xs font-normal text-emerald-400 font-mono">Verified Sightings</span>
          </div>
          <div class="mt-1 text-[11px] font-mono text-zinc-500">Manual Ephemeris Correlated</div>
        </div>

        <!-- Stat 2: Furthest Object in AU (Dynamically Populated as Altair) -->
        <div class="p-4 rounded-xl border border-zinc-800 bg-zinc-950/70 backdrop-blur-md hover:border-blue-500/40 transition-colors">
          <div class="flex items-center justify-between text-xs font-mono text-zinc-500">
            <span class="uppercase tracking-wider">FURTHEST TARGET</span>
            <Orbit class="w-4 h-4 text-blue-400" />
          </div>
          <div class="mt-2 text-2xl font-extrabold font-mono text-blue-300 truncate" title={furthestObject.data.target}>
            {furthestObject.data.target}
          </div>
          <div class="mt-1 text-[11px] font-mono text-zinc-400 flex items-center justify-between">
            <span class="text-zinc-500">Distance:</span>
            <span class="text-cyan-300 font-semibold">{formatDistanceAU(furthestObject.data.ephemeris.distanceAU)}</span>
          </div>
        </div>

        <!-- Stat 3: Latest Target -->
        <div class="p-4 rounded-xl border border-zinc-800 bg-zinc-950/70 backdrop-blur-md hover:border-amber-500/40 transition-colors">
          <div class="flex items-center justify-between text-xs font-mono text-zinc-500">
            <span class="uppercase tracking-wider">LATEST ACQUISITION</span>
            <Activity class="w-4 h-4 text-amber-400" />
          </div>
          <div class="mt-2 text-2xl font-extrabold font-mono text-zinc-100 truncate" title={latestTarget.data.target}>
            {latestTarget.data.target}
          </div>
          <div class="mt-1 text-[11px] font-mono text-zinc-400 flex items-center justify-between">
            <span class="text-zinc-500">Recorded:</span>
            <span class="text-amber-300">{new Date(latestTarget.data.timestamp).toISOString().split('T')[0]}</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Cosmic Scale Ladder Interactive Preview Bar -->
    <div id="scale-ladder" class="mt-12 pt-8 border-t border-zinc-800/60">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
        <div class="flex items-center gap-2 text-xs font-mono font-bold text-zinc-300 uppercase tracking-wider">
          <Orbit class="w-4 h-4 text-cyan-400" />
          <span>COSMIC SCALE LADDER (DISTANCE FROM EARTH)</span>
        </div>
        <div class="flex items-center gap-2 self-start sm:self-auto">
          <span class="sm:hidden text-[10px] text-zinc-500 font-mono">SWIPE LADDER →</span>
          <div class="text-[11px] font-mono text-zinc-400 bg-zinc-900/80 px-2.5 py-1 rounded-md border border-zinc-800/80 whitespace-nowrap">
            <span class="text-zinc-500">LOGARITHMIC STEPPING:</span> 0.0026 AU → <span class="text-cyan-400 font-semibold">16.73 LY (Altair)</span>
          </div>
        </div>
      </div>

      <!-- Responsive Ladder Strip (Smooth swipeable strip on mobile, multi-column grid on desktop) -->
      <div class="flex overflow-x-auto pb-3 sm:pb-0 sm:grid sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-3.5 snap-x snap-mandatory scrollbar-thin">
        {scaleLadderItems.map((item, index) => {
          const au = item.data.ephemeris.distanceAU;
          const lightTime = formatLightTravelTime(item.data.ephemeris.lightTravelTimeMinutes);
          return (
            <div class="group relative p-3.5 rounded-xl border border-zinc-800/80 bg-zinc-900/60 hover:bg-zinc-800/80 hover:border-cyan-500/50 transition-all font-mono text-xs flex flex-col justify-between min-w-[210px] shrink-0 sm:min-w-0 sm:shrink snap-start shadow-sm">
              <!-- Top Row: Rung Index & Distance Badge -->
              <div class="flex items-center justify-between text-[10px] text-zinc-500 mb-2 gap-2 whitespace-nowrap">
                <span class="font-medium text-zinc-400 tracking-wider">RUNG 0{index + 1}</span>
                <span
                  class="text-cyan-400 font-semibold px-1.5 py-0.5 rounded bg-cyan-950/40 border border-cyan-800/40 shrink-0"
                  title={formatDistanceAU(au)}
                >
                  {formatCompactDistance(au)}
                </span>
              </div>

              <!-- Middle: Target Title -->
              <div class="text-sm font-bold text-zinc-100 group-hover:text-cyan-300 transition-colors whitespace-nowrap overflow-hidden text-ellipsis mb-2" title={item.data.target}>
                {item.data.target}
              </div>

              <!-- Bottom Row: Light Delay Readout -->
              <div class="text-[11px] text-zinc-400 border-t border-zinc-800/60 pt-2 flex items-center justify-between gap-2 whitespace-nowrap">
                <span class="text-zinc-500 shrink-0">Light Delay:</span>
                <span class="text-amber-300 font-medium shrink-0">{lightTime}</span>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</section>

