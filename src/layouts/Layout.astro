---
import { Telescope, Radio, Orbit, Activity } from 'lucide-astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'CELESTIAL TELEMETRY ARCHIVE // ASTROPHOTOGRAPHY & EPHEMERIS',
  description = 'High-precision astrophotography portfolio and celestial telemetry archive.',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Space+Grotesk:wght@500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-[#09090b] text-zinc-100 font-sans selection:bg-cyan-500/30 selection:text-cyan-200 antialiased overflow-x-hidden relative">
    <!-- Background Grid & Telemetry Matrix -->
    <div class="fixed inset-0 pointer-events-none z-0">
      <!-- Dark gradient base -->
      <div class="absolute inset-0 bg-radial-gradient from-zinc-900/40 via-[#09090b] to-[#040406]"></div>
      <!-- Subtle dot matrix -->
      <div class="absolute inset-0 bg-grid-pattern bg-[length:24px_24px] opacity-40"></div>
      <!-- Vignette and corner glows -->
      <div class="absolute -top-40 -left-40 w-96 h-96 bg-cyan-500/5 rounded-full blur-3xl"></div>
      <div class="absolute top-1/3 -right-40 w-96 h-96 bg-violet-500/5 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-40 left-1/3 w-96 h-96 bg-emerald-500/5 rounded-full blur-3xl"></div>
      <!-- Subtle horizontal scanlines -->
      <div class="absolute inset-0 bg-hud-scanline bg-[length:100%_4px] opacity-25"></div>
    </div>

    <!-- Top Status Ticker -->
    <header class="relative z-20 border-b border-zinc-800/80 bg-zinc-950/80 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 sm:py-2.5 flex items-center justify-between text-[11px] sm:text-xs font-mono">
        <div class="flex items-center gap-2 sm:gap-3">
          <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded border border-emerald-500/30 bg-emerald-950/40 text-emerald-400 font-medium text-[10px] sm:text-xs">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            SYS: ONLINE
          </span>
          <span class="hidden sm:inline text-zinc-500">|</span>
          <span class="hidden sm:inline text-zinc-400">EPOCH: 2026.83</span>
          <span class="hidden md:inline text-zinc-500">|</span>
          <span class="hidden md:inline text-zinc-400">STATION: MOBILE OPTICAL UNIT</span>
        </div>

        <div class="flex items-center gap-3 sm:gap-4 text-zinc-400">
          <div class="flex items-center gap-1.5 text-[10px] sm:text-xs" id="utc-clock-container">
            <Activity class="w-3 h-3 sm:w-3.5 sm:h-3.5 text-cyan-400" />
            <span class="text-zinc-500">UTC:</span>
            <span id="utc-clock" class="text-cyan-300 font-semibold tracking-wider font-mono">--:--:-- UTC</span>
          </div>
          <a
            href="https://github.com"
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:flex items-center gap-1 text-zinc-400 hover:text-cyan-400 transition-colors"
          >
            <span>v2.4.0</span>
          </a>
        </div>
      </div>
    </header>

    <!-- Main Navigation Bar -->
    <nav class="relative z-20 border-b border-zinc-800/50 bg-[#09090b]/80 backdrop-blur-lg sticky top-0">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-14 sm:h-16 flex items-center justify-between">
        <a href="/" class="group flex items-center gap-2.5 sm:gap-3">
          <div class="relative w-8 h-8 sm:w-9 sm:h-9 rounded-lg bg-zinc-900 border border-zinc-700/80 flex items-center justify-center text-cyan-400 group-hover:border-cyan-500/60 group-hover:shadow-glow-cyan transition-all shrink-0">
            <Telescope class="w-4 h-4 sm:w-5 sm:h-5 transition-transform group-hover:scale-110" />
            <span class="absolute -top-1 -right-1 w-2 h-2 rounded-full bg-cyan-400 ring-2 ring-zinc-950"></span>
          </div>
          <div>
            <div class="text-xs sm:text-sm font-bold tracking-widest text-zinc-100 group-hover:text-cyan-300 transition-colors uppercase font-mono flex items-center gap-1.5 sm:gap-2">
              <span>SPACE-SIGHTINGS</span>
              <span class="text-[9px] sm:text-[10px] px-1.5 py-0.2 rounded bg-cyan-950/80 text-cyan-400 border border-cyan-800/50 font-normal">ARCHIVE</span>
            </div>
            <div class="hidden sm:block text-[10px] text-zinc-500 tracking-wider font-mono">OPTICAL TELEMETRY &amp; ASTROPHOTOGRAPHY</div>
          </div>
        </a>

        <div class="flex items-center gap-2 sm:gap-3">
          <a
            href="/"
            class="px-2.5 sm:px-3 py-1.5 rounded-md text-xs font-mono font-medium text-zinc-200 hover:text-cyan-400 hover:bg-zinc-800/60 transition-colors flex items-center gap-1.5"
          >
            <Orbit class="w-3.5 h-3.5 text-cyan-400" />
            <span>Archive</span>
          </a>
          <a
            href="/#scale-ladder"
            class="px-2.5 sm:px-3 py-1.5 rounded-md text-xs font-mono text-zinc-400 hover:text-cyan-400 hover:bg-zinc-800/60 transition-colors flex items-center gap-1.5"
          >
            <Radio class="w-3.5 h-3.5 text-amber-400" />
            <span>Ladder</span>
          </a>
        </div>
      </div>
    </nav>

    <!-- Page Content Container -->
    <div class="relative z-10">
      <slot />
    </div>

    <!-- Sci-Fi Telemetry Footer -->
    <footer class="relative z-20 border-t border-zinc-800/80 bg-zinc-950 mt-24 py-12 text-zinc-400 font-mono text-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-8">
        <div class="md:col-span-2 space-y-3">
          <div class="flex items-center gap-2 text-zinc-200 font-bold tracking-wider">
            <span class="w-2 h-2 bg-cyan-400 rounded-sm"></span>
            CELESTIAL TELEMETRY ARCHIVE
          </div>
          <p class="text-zinc-500 text-xs leading-relaxed max-w-md">
            Ground-based astrophotography catalog and high-precision ephemeris database. All orbital positions, apparent magnitudes, and light travel delays verified against Stellarium / JPL Horizons planetary ephemeris models.
          </p>
          <div class="text-[11px] text-zinc-600">
            STATION COORDINATES: 37°18'N 121°54'W · BORTLE CLASS 2–4 · 2026 OBSERVATIONAL CAMPAIGN
          </div>
        </div>

        <div>
          <div class="text-zinc-300 font-semibold mb-3 tracking-wider">CATALOG SECTORS</div>
          <ul class="space-y-1.5 text-zinc-500">
            <li><a href="/?cat=solar-system" class="hover:text-cyan-400 transition-colors">» Solar System (Gas Giants &amp; Moons)</a></li>
            <li><a href="/?cat=lunar" class="hover:text-cyan-400 transition-colors">» Lunar (Terminator &amp; Earthshine)</a></li>
            <li><a href="/?cat=solar" class="hover:text-cyan-400 transition-colors">» Solar (Photosphere &amp; Active Regions)</a></li>
            <li><a href="/?cat=stellar" class="hover:text-cyan-400 transition-colors">» Stellar (A-Type Main Sequence &amp; Constellations)</a></li>
          </ul>
        </div>

        <div>
          <div class="text-zinc-300 font-semibold mb-3 tracking-wider">OPTICAL HARDWARE</div>
          <ul class="space-y-1.5 text-zinc-500 text-[11px]">
            <li>· Celestron Omni XLT 150 (750mm f/5)</li>
            <li>· Celestron C8 SCT (2032mm f/10)</li>
            <li>· WO Zenithstar 71 APO Refractor</li>
            <li>· Baader ND 5.0 Solar Safety Filter</li>
            <li>· Sony 1" Mobile Sensor (IMX989 Raw)</li>
          </ul>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 pt-6 border-t border-zinc-900 flex flex-col sm:flex-row items-center justify-between text-zinc-600 text-[11px]">
        <div>© 2026 SPACE-SIGHTINGS OBSERVATION GROUP. ALL RIGHTS RESERVED.</div>
        <div class="mt-2 sm:mt-0 font-mono text-cyan-500/80">POWERED BY ASTRO + TAILWIND CSS + STELLARIUM</div>
      </div>
    </footer>

    <!-- Client-side Telemetry Live Clock Script -->
    <script>
      function updateClock() {
        const now = new Date();
        const clockEl = document.getElementById('utc-clock');
        if (clockEl) {
          const hours = String(now.getUTCHours()).padStart(2, '0');
          const minutes = String(now.getUTCMinutes()).padStart(2, '0');
          const seconds = String(now.getUTCSeconds()).padStart(2, '0');
          const ms = String(Math.floor(now.getUTCMilliseconds() / 100));
          clockEl.textContent = `${hours}:${minutes}:${seconds}.${ms} UTC`;
        }
      }
      setInterval(updateClock, 100);
      updateClock();
    </script>
  </body>
</html>

